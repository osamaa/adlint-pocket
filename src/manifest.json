{
  "manifest_version": 3,
  "name": "AdLint Pocket",
  "version": "0.1.0",
  "description": "Check ad copy and images on your own device before launch. Gemini Nano first, cloud only with your OK.",
  "minimum_chrome_version": "139",
  "action": {
    "default_title": "AdLint Pocket",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "contextMenus", "storage"]
}
